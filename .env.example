# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: text or json
# Use 'json' for production to enable structured logging
LOG_FORMAT=text

# Enable colored console output (true/false)
# Disable in production/CI environments
LOG_COLOR=true

# Enable file logging (true/false)
# Logs will be stored in ./logs directory with rotation
LOG_FILE_ENABLED=false

# Database Configuration
DATABASE_URL=sqlite:///./rtm_automation.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Confluence Configuration (optional)
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=

# Jira Configuration (optional)
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
